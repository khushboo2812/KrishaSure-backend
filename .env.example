# Copy to .env for local use. On Render these are set in the service's
# Environment tab. NEVER commit a real .env.

# --- Which environment is this? --------------------------------------
# Leave APP_ENV unset (or 'production') for production. Use 'uat' for the test server.
APP_ENV=uat
APP_URL=https://uat.krishasure.io
API_URL=https://uat-api.krishasure.io
SUPPORT_EMAIL_DOMAIN=tickets-uat.krishasure.io

# --- Database + file storage: the UAT Supabase project, NOT production -
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Host part of the PRODUCTION db URL; the UAT server refuses to start if it matches
PRODUCTION_DB_HOST=

# --- Secrets: use different values from production ---------------------
JWT_SECRET=
GEMINI_API_KEY=

# --- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# UAT only: the only recipients that get real email. Comma-separated
# addresses, or @domain.com for a whole domain. Everyone else is dropped.
UAT_EMAIL_ALLOWLIST=you@yourdomain.com

PORT=5000
